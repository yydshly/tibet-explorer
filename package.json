{
  "name": "tibet-explorer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:narration-assets": "node --test tests/narration-assets.integration.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "narration:prepare": "node scripts/prepare-narration.mjs",
    "narration:verify": "node scripts/verify-narration.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "^0.186.1",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
