  "cues": [
    {
      "start": 0,
      "end": 12.531655328798186,
      "text": "进入狮泉河，再回到同一条河与两岸空间。二〇一七年一河两岸建设增加了绿化、步行和休闲等用途，持续管护参与日常使用。",
      "textStart": 0,
      "textEnd": 56
    },
    {
      "start": 12.672,
      "end": 20.733814058956916,
      "text": "交通让人进入地方，公共空间建设组织停留与活动，它们是不同年份、不同工作的共同参与。",
      "textStart": 56,
      "textEnd": 97
    }
  ],
