  "cues": [
    {
      "start": 0,
      "end": 13.762312925170068,
      "text": "地表受热不均，参与形成气压差，空气便在气压差推动下流动。看上升、向外输送、下沉与返回怎样连起来；地球自转还使运动方向偏转。",
      "textStart": 0,
      "textEnd": 61
    },
    {
      "start": 13.932,
      "end": 24.00234013605442,
      "text": "空气同时搬运热量与水汽：水从地表蒸发，随风移动，湿空气上升冷却时才可能成云。这是大尺度平均关系。",
      "textStart": 61,
      "textEnd": 109
    }
  ],
