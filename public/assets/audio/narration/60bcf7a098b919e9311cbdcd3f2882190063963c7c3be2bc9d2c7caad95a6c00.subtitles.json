  "cues": [
    {
      "start": 0,
      "end": 16.014648526077096,
      "text": "资料讨论大昭寺附近三座历史碑的保护棚：保护实物的作用与视线、历史环境的代价需要一起评估。模型保持同一活动，逐步加入收益、生态和地方生活。",
      "textStart": 0,
      "textEnd": 68
    },
    {
      "start": 16.164,
      "end": 24.260643990929704,
      "text": "罗布林卡缓冲区调整在该资料中仍是拟议，报告、建议与完成结果要分别阅读。",
      "textStart": 68,
      "textEnd": 103
    }
  ],
