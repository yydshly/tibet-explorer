  "cues": [
    {
      "start": 0,
      "end": 10.604399092970523,
      "text": "高度、来流、水汽与山谷方向共同参与环境形成；它们的组合随地区改变。画面使用同一高程网格与城区定位点。",
      "textStart": 0,
      "textEnd": 50
    },
    {
      "start": 10.804399092970524,
      "end": 19.48154195011338,
      "text": "地形可一起读，温度、降水和植被还需对应资料；一处谷地不能代替整个林芝。",
      "textStart": 50,
      "textEnd": 85
    }
  ],
