  "cues": [
    {
      "start": 0,
      "end": 13.309523809523808,
      "text": "主车先到节点，接驳车辆再走另一段，最后人物沿踏步走到入口外。每一段都有独立条件：是否开行、怎样换乘、能否到达、是否开放和需要预约。",
      "textStart": 0,
      "textEnd": 65
    },
    {
      "start": 13.50952380952381,
      "end": 18.61079365079365,
      "text": "模型中的闸口保持待核实；到达入口不等于已经获准进入。",
      "textStart": 65,
      "textEnd": 91
    }
  ],
