  "cues": [
    {
      "start": 0,
      "end": 5.437959183673469,
      "text": "十七世纪，甘丹颇章政权形成，拉萨政治与建筑空间继续变化。",
      "textStart": 0,
      "textEnd": 28
    },
    {
      "start": 5.637959183673469,
      "end": 19.887891156462583,
      "text": "清代的驻藏大臣和噶厦进入制度史；二十世纪又经历一九〇四年英国军事行动、一九五一年协议、一九五九年冲突及改革、一九六五年自治区成立。",
      "textStart": 28,
      "textEnd": 93
    },
    {
      "start": 20.052,
      "end": 22.575854875283447,
      "text": "每个节点都要再看地方经历。",
      "textStart": 93,
      "textEnd": 106
    }
  ],
