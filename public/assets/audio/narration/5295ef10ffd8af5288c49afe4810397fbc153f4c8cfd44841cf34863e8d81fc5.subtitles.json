  "cues": [
    {
      "start": 0,
      "end": 10.441859410430837,
      "text": "把地区差异接到生活。山南与拉萨的河谷，较缓土地为聚居和耕作提供空间；但建城仍需要人的组织。",
      "textStart": 0,
      "textEnd": 45
    },
    {
      "start": 10.641859410430838,
      "end": 17.101496598639454,
      "text": "林芝与昌都的山地河谷，让沿谷与跨山面对不同高差，通行还需要道路和维护。",
      "textStart": 45,
      "textEnd": 80
    },
    {
      "start": 17.244,
      "end": 29.404136054421766,
      "text": "再看阿里：二〇二三年的报道记录了狮泉河盆地林地灌溉与管护，水源通过设施和劳动才被使用。这个地方例证不能代表所有社区。",
      "textStart": 80,
      "textEnd": 138
    },
    {
      "start": 29.60413605442177,
      "end": 33.846267573696146,
      "text": "回到全域，用土地、水和通行继续比较。",
      "textStart": 138,
      "textEnd": 156
    }
  ],
