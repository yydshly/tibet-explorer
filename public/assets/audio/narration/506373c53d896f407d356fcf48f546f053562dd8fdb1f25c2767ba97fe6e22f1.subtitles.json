  "cues": [
    {
      "start": 0,
      "end": 14.49374149659864,
      "text": "地形能说明哪里较平、哪里有水，却不能直接解释一座城为何成为中心，或一种文化怎样形成。接下来把同一张地图放进时间：先看人群活动与历史长线，再沿真实材料走近地方。",
      "textStart": 0,
      "textEnd": 79
    },
    {
      "start": 14.652,
      "end": 18.975401360544215,
      "text": "年代、人的行动和空间用途，需要一起阅读。",
      "textStart": 79,
      "textEnd": 99
    }
  ],
