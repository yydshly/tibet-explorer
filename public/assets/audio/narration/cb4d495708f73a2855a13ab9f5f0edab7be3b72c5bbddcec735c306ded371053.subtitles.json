  "cues": [
    {
      "start": 0,
      "end": 13.181814058956915,
      "text": "公开高程说明今天哪里高、哪里低；为什么形成这些起伏，还需要地质与年代材料。下面会明确换成概念河谷，解释汇水、侵蚀、搬运和堆积。",
      "textStart": 0,
      "textEnd": 63
    },
    {
      "start": 13.32,
      "end": 19.98861678004535,
      "text": "真实地点与一般原理互相核对，而不是把一段动画当成林芝或札达的地貌历史。",
      "textStart": 63,
      "textEnd": 98
    }
  ],
