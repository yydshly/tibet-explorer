  "cues": [
    {
      "start": 0,
      "end": 13.797142857142857,
      "text": "观察留在鲁朗，对照道路、河谷和同一处服务用地。车辆怎样经过，人在哪里停留，住宿接待需要哪些工作？再读二〇一六年试运营和二〇一七年旅馆培训的记录。",
      "textStart": 0,
      "textEnd": 72
    },
    {
      "start": 13.968,
      "end": 17.432263038548754,
      "text": "林芝的工布课堂在另一地点，不能混作小镇现场。",
      "textStart": 72,
      "textEnd": 94
    }
  ],
