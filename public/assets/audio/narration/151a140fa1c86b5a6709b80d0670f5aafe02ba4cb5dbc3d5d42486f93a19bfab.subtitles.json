  "cues": [
    {
      "start": 0,
      "end": 10.18643990929705,
      "text": "让湿空气遇山上升，观察冷却、云和雨的变化。山南地方资料记载降水主要集中在六月到九月，不同高度和位置又有差别。",
      "textStart": 0,
      "textEnd": 54
    },
    {
      "start": 10.386439909297051,
      "end": 16.880907029478458,
      "text": "动画用来理解抬升与水汽条件，不表示每条沟谷都有同样风向和降水量。",
      "textStart": 54,
      "textEnd": 86
    }
  ],
