{
  "id": "G318-travel-access-gate-20261020",
  "date": "2026-10-20",
  "status": "bounded_source_gate_complete_conditional_storyboard",
  "baseline": "c7ab41e",
  "scope": "四处入口/道路/免费清洁素材核查与旅行者分镜；不改冻结产品。",
  "decision": "色季拉与鲁朗可在资料边界内细化；通麦保留途中观察；巴卡森林仅保留有条件候选，真实入林暂缓。",
  "places": [
    {
      "id": "A1",
      "name": "色季拉远眺候选",
      "status": "部分可用：道路与POI有据，观景承诺缩减",
      "entry": "OSM记录南迦巴瓦观景POI8795758950与停车POI8795758949，旁侧服务路1564915508与归档主路共享节点。",
      "connection": "原始服务路可追到POI附近；最近道路顶点距观景POI约8米、距停车POI约12米，空缺不补线。两处saddle记录与公开海拔口径不一致，不采用该ele标注。",
      "watch": "连续上山、回望谷地、天气与可见范围；远峰保持有条件的观看目标。",
      "experience": "观景停留作为候选；当前收费、开放、停车出入口和步行仍待核。",
      "media": "两张2015原图可作天气与地方环境分镜参考；没有本轮核准的清晰远峰或金山原片。",
      "decision": "可写翻山与天气分镜；缩减清晰远峰、日照金山和停车步行的实景承诺。",
      "approaches": [
        "sejila-8795758949",
        "sejila-8795758950"
      ],
      "sources": [
        "AG06",
        "AG07"
      ]
    },
    {
      "id": "A2",
      "name": "鲁朗小镇与扎西岗村",
      "status": "可用：地方接近与已有实拍；村内路线缩减",
      "entry": "传统村落另用主路节点624468845，经来源道路1120342679、桥1120342680及村道接近扎西岗村参照5224686709。",
      "connection": "地图中约946米的连续道路到最近村道顶点，距村参照约60米；此为数据链长度，不是实际入口里程。原有小镇接入节点7365874802保留，两者不替换。",
      "watch": "林海、草甸、水与村镇，公共生活和现代旅游小镇的区别。",
      "experience": "村镇公共空间观察与地方风味为主要停留选择；不默认入户、骑马、表演或节庆。",
      "media": "复用既有五份清洁实拍及各自日期/许可；2024小镇照片不能代表整个扎西岗传统村落。",
      "decision": "可进入地方观察分镜；村口、停车、公共步行闭环及实时服务没有全部核准。",
      "approaches": [
        "lulang-5224686709"
      ],
      "sources": [
        "AG04",
        "AG05",
        "AG06"
      ]
    },
    {
      "id": "A3",
      "name": "通麦江流与桥的观察",
      "status": "缩减：保留途中观察，暂停步行观景",
      "entry": "官方介绍确认桥旁观景台的存在；本轮未核到与该设施一一对应的入口坐标。",
      "connection": "OSM未具名attraction6304966287不能认作观景台。接近它的候选算法路径经过旧桥26406907，与历史材料中的旧桥不可通行边界冲突，已拒用。",
      "watch": "原主路上的峡谷、易贡藏布与帕隆藏布关系、桥隧和交通历史。",
      "experience": "以途中与地图视角观察为主；暂不引导下车、上旧桥或沿未核道路走到平台。",
      "media": "2014旧桥清洁实拍可复用但明确年代；限定检索仅返回同一旧照，未取得新桥近景或连续实拍。",
      "decision": "保留主路与有日期历史对照，删去本轮未经核准的观景步行分镜。",
      "approaches": [],
      "sources": [
        "AG03",
        "AG06"
      ]
    },
    {
      "id": "A4",
      "name": "波密森林·巴卡村方向",
      "status": "有条件：步行选题成立，真实入林镜头暂缓",
      "entry": "官方材料给出巴卡村往返与两端穿越两种走法；本版只保留巴卡村往返候选，另一端名称按各来源保留。",
      "connection": "归档主路节点4037129072经道路912953948、桥912953949和401281172到巴卡方向接近道路。该段终点距村名参照点约612米，不认作村口。401281165虽标residential，却注明1米宽、碎石与徒步属性，已从普通行车段排除；村内与森林步道缺失。",
      "watch": "森林、草湖和村落共同构成的地方体验；与鲁朗的开敞谷地对照。",
      "experience": "拟从巴卡村入林、原路返回主路；步道几何、入口开放和可再利用的实拍都齐备后才制作，不默认两端接送。",
      "media": "一次限定Commons查询返回3项同名异地素材，全部排除；官方森林图文保留版权，没有取得免费影像再利用准入。",
      "decision": "在到县城之前展示可选支线关系与待核事项；真实入林、草湖漫游和现场文化活动分镜暂缓。",
      "approaches": [
        "baka-13132782034"
      ],
